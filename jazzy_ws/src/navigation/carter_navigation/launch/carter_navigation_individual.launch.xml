<launch>
  <arg name="namespace" default="" description="Top-level namespace"/>
  <arg name="use_namespace" default="False" description="Whether to apply a namespace to the navigation stack"/>
  <arg name="slam" default="False" description="Whether to run SLAM"/>
  <arg name="map" default="$(find-pkg-share carter_navigation)/maps/carter_warehouse_navigation.yaml" description="Full path to map file to load"/>
  <arg name="use_sim_time" default="True" description="Use simulation (Isaac Sim) clock if true"/>
  <arg name="params_file" default="$(find-pkg-share carter_navigation)/params/carter_navigation_params.yaml" description="Full path to the ROS 2 parameters file for launched nodes"/>
  <arg name="default_bt_xml_filename" default="$(find-pkg-share nav2_bt_navigator)/behavior_trees/navigate_w_replanning_and_recovery.xml" description="Full path to the behavior tree XML file"/>
  <arg name="autostart" default="True" description="Automatically start the Nav2 stack"/>
  <include file="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py">
    <arg name="namespace" value="$(var namespace)"/><arg name="use_namespace" value="$(var use_namespace)"/>
    <arg name="slam" value="$(var slam)"/><arg name="map" value="$(var map)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/><arg name="params_file" value="$(var params_file)"/>
    <arg name="default_bt_xml_filename" value="$(var default_bt_xml_filename)"/><arg name="autostart" value="$(var autostart)"/>
  </include>
</launch>
