<launch>
  <arg name="gui" default="https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.1/Isaac/Samples/ROS2/Scenario/carter_warehouse_navigation.usd" description="Path to the Isaac Sim scene"/>
  <arg name="map" default="$(find-pkg-share carter_navigation)/maps/carter_warehouse_navigation.yaml" description="Full path to map file to load"/>
  <arg name="params_file" default="$(find-pkg-share carter_navigation)/params/carter_navigation_params.yaml" description="Full path to parameter file to load"/>
  <arg name="use_sim_time" default="True" description="Use simulation (Isaac Sim) clock if true"/>
  <include file="$(find-pkg-share isaacsim_bringup)/launch/run_isaacsim.launch.xml">
    <arg name="version" value="6.1.0"/><arg name="gui" value="$(var gui)"/><arg name="play_sim_on_start" value="True"/>
  </include>
  <include file="$(find-pkg-share carter_navigation)/launch/carter_navigation.launch.xml">
    <arg name="map" value="$(var map)"/><arg name="params_file" value="$(var params_file)"/><arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>
  <include file="$(find-pkg-share carter_navigation)/launch/carter_navigation_goal_on_isaacsim_ready.launch.py">
    <arg name="map_yaml_path" value="$(var map)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>
</launch>
