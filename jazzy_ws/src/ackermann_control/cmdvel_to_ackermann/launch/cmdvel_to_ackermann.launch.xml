<launch>
  <arg name="publish_period_ms" default="20" description="publishing dt in milliseconds"/>
  <arg name="track_width" default="0.24" description="wheel separation distance (m)"/>
  <arg name="wheelbase" default="0.32" description="front-to-rear wheel distance used for steering conversion (m)"/>
  <arg name="acceleration" default="0.0" description="acceleration, 0 means change speed as quickly as possible (ms^-2)"/>
  <arg name="steering_velocity" default="0.0" description="delta steering angle, 0 means change angle as quickly as possible (radians/s)"/>
  <arg name="frame_id" default="ackermann" description="frame_id for published AckermannDriveStamped messages"/>
  <arg name="cmd_vel_topic" default="cmd_vel" description="Twist input topic"/>
  <arg name="ackermann_topic" default="ackermann_cmd" description="AckermannDriveStamped output topic"/>
  <arg name="use_sim_time" default="true" description="Use simulation (Isaac Sim) clock if true"/>

  <node pkg="cmdvel_to_ackermann" exec="cmdvel_to_ackermann" name="cmdvel_to_ackermann" output="screen">
    <param name="publish_period_ms" value="$(var publish_period_ms)" type="int"/>
    <param name="track_width" value="$(var track_width)" type="float"/>
    <param name="wheelbase" value="$(var wheelbase)" type="float"/>
    <param name="acceleration" value="$(var acceleration)" type="float"/>
    <param name="steering_velocity" value="$(var steering_velocity)" type="float"/>
    <param name="frame_id" value="$(var frame_id)" type="str"/>
    <param name="cmd_vel_topic" value="$(var cmd_vel_topic)" type="str"/>
    <param name="ackermann_topic" value="$(var ackermann_topic)" type="str"/>
    <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
  </node>
</launch>
