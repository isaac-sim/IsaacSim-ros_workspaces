<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<launch>
  <arg name="use_sim_time" default="true" description="Use the simulation clock"/>
  <arg name="robot_description_file" default=""
       description="Optional URDF file. When empty, read robot_description_topic with transient-local reliable QoS."/>
  <arg name="robot_description_topic" default="/robot_description"
       description="Isaac Sim std_msgs/String topic containing the URDF"/>
  <arg name="robot_description_timeout" default="60.0"
       description="Seconds to wait for Isaac Sim's robot description"/>

  <let name="robot_description"
       value="$(if $(eval &quot;'$(var robot_description_file)' != ''&quot;) $(file-content $(var robot_description_file)) $(command '$(exec-in-pkg read_robot_description isaac_ros2_control_demo) --topic $(var robot_description_topic) --timeout $(var robot_description_timeout)'))"/>
  <let name="robot_description_semantic"
       value="$(file-content $(find-pkg-share isaac_ros2_control_demo)/srdf/ur10.srdf)"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="both">
    <param name="robot_description" value="$(var robot_description)" type="str"/>
    <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
  </node>

  <node pkg="moveit_ros_move_group" exec="move_group" output="screen">
    <param name="robot_description" value="$(var robot_description)" type="str"/>
    <param name="robot_description_semantic" value="$(var robot_description_semantic)" type="str"/>
    <param from="$(find-pkg-share isaac_ros2_control_demo)/config/kinematics.yaml"/>
    <param from="$(find-pkg-share isaac_ros2_control_demo)/config/ompl_planning.yaml"/>
    <param from="$(find-pkg-share isaac_ros2_control_demo)/config/joint_limits.yaml"/>
    <param from="$(find-pkg-share isaac_ros2_control_demo)/config/moveit_controllers.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
  </node>

  <node pkg="rviz2" exec="rviz2" output="log"
        args="-d $(find-pkg-share isaac_ros2_control_demo)/rviz/ur10_moveit.rviz">
    <param name="robot_description" value="$(var robot_description)" type="str"/>
    <param name="robot_description_semantic" value="$(var robot_description_semantic)" type="str"/>
    <param from="$(find-pkg-share isaac_ros2_control_demo)/config/kinematics.yaml"/>
    <param name="use_sim_time" value="$(var use_sim_time)" type="bool"/>
  </node>

  <node pkg="isaac_ros2_control_demo" exec="add_floor" output="log"/>
  <node pkg="controller_manager" exec="spawner" output="log"
        args="joint_state_broadcaster --controller-manager /controller_manager"/>
  <node pkg="controller_manager" exec="spawner" output="log"
        args="scaled_joint_trajectory_controller --controller-manager /controller_manager"/>
</launch>
